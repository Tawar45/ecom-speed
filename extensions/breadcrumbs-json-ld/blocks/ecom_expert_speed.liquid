<div {{ block.shopify_attributes }} hidden></div>
{% if block.settings.enabled %}
<script>
  window.EcomSpeedExpertConfig = Object.assign({}, window.EcomSpeedExpertConfig || {}, {
    hoverDelayMs: {{ block.settings.hover_delay | default: 65 | json }},
    touchCooldownMs: {{ block.settings.touch_cooldown | default: 1100 | json }},
    allowExternalLinks: {{ block.settings.allow_external | json }},
    allowQueryStrings: {{ block.settings.allow_query_strings | json }},
    respectDataSaver: {{ block.settings.respect_data_saver | json }}
  });
</script>
{{ 'ecom-speed-expert.js' | asset_url | script_tag }}
{% endif %}

{% schema %}
{
  "name": "Page Speed Expert",
  "target": "body",
  "settings": [
    {
      "type": "header",
      "content": "About The App",
      "info": "Free Plan works only on the home page. Expert Plan works on all pages: products, collections, blog, search, cart, checkout, and other pages."
    },
    {
      "type": "checkbox",
      "id": "enabled",
      "label": "Enable instant prefetch",
      "default": true,
      "info": "Preloads pages when users hover or touch links."
    },
    {
      "type": "range",
      "id": "hover_delay",
      "label": "Mouse hover delay",
      "min": 0,
      "max": 300,
      "step": 5,
      "unit": "ms",
      "default": 65,
      "info": "Time to wait before prefetching on hover."
    },
    {
      "type": "range",
      "id": "touch_cooldown",
      "label": "Touch cooldown",
      "min": 0,
      "max": 2000,
      "step": 100,
      "unit": "ms",
      "default": 1100,
      "info": "Ignore mouse events for this long after a touch."
    },
    {
      "type": "checkbox",
      "id": "allow_external",
      "label": "Allow external links",
      "default": false,
      "info": "Prefetch links to other domains."
    },
    {
      "type": "checkbox",
      "id": "allow_query_strings",
      "label": "Allow query strings",
      "default": false,
      "info": "Prefetch URLs that include query parameters."
    },
    {
      "type": "checkbox",
      "id": "respect_data_saver",
      "label": "Respect Data Saver mode",
      "default": true,
      "info": "Skip prefetching when the visitor has data saver enabled."
    }
  ]
}
{% endschema %}
